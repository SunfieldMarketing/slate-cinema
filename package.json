{
  "name": "slate-cinema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local src/seed/index.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local ./node_modules/payload/bin.js generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local ./node_modules/payload/bin.js generate:types",
    "migrate": "echo y | cross-env NODE_OPTIONS=--no-deprecation node ./node_modules/payload/bin.js migrate",
    "migrate:local": "echo y | cross-env NODE_OPTIONS=--no-deprecation node --env-file=.env.local ./node_modules/payload/bin.js migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation node --env-file=.env.local ./node_modules/payload/bin.js migrate:create",
    "build": "npm run migrate && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/plugin-form-builder": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/storage-vercel-blob": "^3.88.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@studio-freight/react-lenis": "^0.0.47",
    "@types/three": "^0.184.1",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "jotai": "^2.20.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "motion": "^12.42.2",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "payload": "^3.88.0",
    "posthog-js": "^1.404.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "ffmpeg-static": "^5.3.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
