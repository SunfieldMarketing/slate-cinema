# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# payload cms — local sqlite db file + local-disk upload fallback are
# runtime data, correctly ignored. src/app/(payload)/admin/importMap.js
# and src/payload-types.ts are NOT ignored (deliberately) -- importMap.js
# is imported directly by layout.tsx/admin page.tsx at build time; a
# gitignored copy works in local dev (file exists on disk, just
# untracked) but fails every CI/Vercel build with
# "Module not found: Can't resolve '../importMap.js'" since it never
# gets committed. See CMS_MIGRATION_PHASE0_INVENTORY.md pitfalls.
*.sqlite
*.sqlite3
slate-cinema.db
# Media collection's local-disk upload fallback (staticDir: 'media' in
# src/collections/Media.ts) -- resolves relative to the project root,
# not /public. Production uses Vercel Blob once BLOB_READ_WRITE_TOKEN
# is set; without it, local dev writes here.
/media
