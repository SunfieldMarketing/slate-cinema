# --- Payload CMS ---
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# file:./slate-cinema.db locally; libsql://<db>.turso.io in prod (Turso, same
# adapter, no code change) or postgres://... / postgresql://... for Postgres.
DATABASE_URI=file:./slate-cinema.db
# Only needed if DATABASE_URI is a Turso libsql:// URL.
DATABASE_AUTH_TOKEN=

# Used for Payload's CORS/CSRF allow-list.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Already used sitewide (sitemap.ts, robots.ts, layout.tsx JSON-LD) for
# canonical URLs -- same value as NEXT_PUBLIC_SERVER_URL in practice.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin user — created once by `npx tsx src/seed/index.ts` when the
# users collection is empty, never through Payload's public
# "create first user" screen. 8+ characters, never commit the real value.
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=

# Media storage — Vercel Blob. Without this, uploads fall back to local
# disk, which is fine for local dev but must never be what production
# runs on (redeploys wipe the local filesystem).
BLOB_READ_WRITE_TOKEN=

# --- Already in use elsewhere on the site (see CMS_MIGRATION_PHASE0_INVENTORY.md) ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# GHL webhook forwarding -- optional, no-ops if unset (src/lib/ghl.ts).
# URL for each: GHL > Automation > Workflows > (workflow) > Add Trigger >
# "Inbound Webhook" -- copy the URL it generates.
GHL_LEAD_WEBHOOK_URL=
GHL_BOOKING_WEBHOOK_URL=

# Google Ads conversion tracking -- optional, GoogleAdsTag.tsx renders
# nothing until this is set. Format "AW-XXXXXXXXX", from Google Ads >
# Tools & Settings > Conversions > the account-level tag snippet.
NEXT_PUBLIC_GOOGLE_ADS_ID=
